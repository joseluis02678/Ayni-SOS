FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/README.md* ./
COPY backend/app ./app

RUN pip install --no-cache-dir -e ".[dev]" || pip install --no-cache-dir \
    "fastapi>=0.115.0" "uvicorn[standard]>=0.32.0" "sqlalchemy[asyncio]>=2.0.36" \
    "geoalchemy2>=0.15.2" "asyncpg>=0.30.0" "alembic>=1.14.0" \
    "pydantic[email]>=2.10.0" "pydantic-settings>=2.6.0" \
    "python-jose[cryptography]>=3.3.0" "passlib[bcrypt]>=1.7.4" "bcrypt<4.1" \
    "python-multipart>=0.0.17" "redis>=5.2.0" "minio>=7.2.12" "httpx>=0.28.0"

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
