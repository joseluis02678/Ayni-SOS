# Ayni SOS Backend — copy to .env and adjust
APP_NAME=Ayni SOS API
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./ayni_sos_local.db
# DATABASE_URL=postgresql+asyncpg://ayni:ayni_secret@localhost:5432/ayni_sos
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production-ayni-sos-research-proto
USE_LOCAL_MEDIA=true
LOCAL_MEDIA_DIR=./media_store
SMS_GATEWAY_ENABLED=true
SMS_INBOUND_SECRET=ayni-sms-inbound-secret
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ayni_minio
MINIO_SECRET_KEY=ayni_minio_secret
MINIO_BUCKET=ayni-evidence
MINIO_SECURE=false
