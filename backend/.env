# Ayni SOS Backend — local prototype (no Docker required)
APP_NAME=Ayni SOS API
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./ayni_sos_local.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production-ayni-sos-research-proto
USE_LOCAL_MEDIA=true
LOCAL_MEDIA_DIR=./media_store
SMS_GATEWAY_ENABLED=true
SMS_INBOUND_SECRET=ayni-sms-inbound-secret
